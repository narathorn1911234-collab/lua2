-- นำสคริปต์นี้ไปใส่ใน StarterPlayer -> StarterCharacterScripts
local player = game.Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local root = char:WaitForChild("HumanoidRootPart")
local rightLimb = char:WaitForChild("RightHand") or char:WaitForChild("Right Arm") -- รองรับทั้ง R15 และ R6
local uis = game:GetService("UserInputService")
local runService = game:GetService("RunService")

-- ==========================================
-- 1. สร้างเพลงเท่ๆ
-- ==========================================
local music = Instance.new("Sound")
music.Name = "CoolBGM"
music.SoundId = "rbxassetid://1843477124" -- สามารถเปลี่ยน ID เพลงตรงนี้ได้
music.Volume = 0.5
music.Looped = true
music.Parent = root
music:Play()

-- ==========================================
-- 2. ฟังก์ชันสำหรับสร้างดาบยักษ์
-- ==========================================
local function createGiantSword(name, isNeon)
	local sword = Instance.new("Part")
	sword.Name = name
	sword.Size = Vector3.new(1, 10, 3) -- ขนาดใหญ่พิเศษ (ดาบยักษ์)
	if isNeon then
		sword.Material = Enum.Material.Neon
		sword.Color = Color3.fromRGB(0, 255, 255) -- สีฟ้าเรืองแสง
	else
		sword.Material = Enum.Material.Metal
		sword.Color = Color3.fromRGB(100, 100, 100) -- สีเหล็ก
	end
	sword.CanCollide = false
	sword.Massless = true
	return sword
end

-- สร้างดาบหลัก (ถือไว้ที่มือ)
local mainSword = createGiantSword("MainSword", false)
mainSword.Parent = char

local mainWeld = Instance.new("Motor6D")
mainWeld.Part0 = rightLimb
mainWeld.Part1 = mainSword
mainWeld.C0 = CFrame.new(0, -1, 0) * CFrame.Angles(math.rad(90), 0, 0)
mainWeld.Parent = mainSword

-- สร้างดาบยักษ์ลอยด้านหลัง 3 เล่ม (สำหรับท่าที่ 3)
local floatingSwords = {}
for i = 1, 3 do
	local fs = createGiantSword("FloatingSword"..i, true)
	fs.Transparency = 1 -- ซ่อนไว้ก่อน
	fs.Parent = char
	
	local fweld = Instance.new("Motor6D")
	fweld.Part0 = root
	fweld.Part1 = fs
	fweld.Parent = fs
	
	table.insert(floatingSwords, {sword = fs, weld = fweld})
end

-- ==========================================
-- 3. ระบบควบคุมท่าทาง (Pose System)
-- ==========================================
local currentPose = 1
local spinConnection

local function updatePose()
	-- ล้างค่าท่าทางเดิม (หยุดหมุน, ซ่อนดาบหลัง)
	if spinConnection then 
		spinConnection:Disconnect() 
		spinConnection = nil
	end
	
	for _, fs in pairs(floatingSwords) do
		fs.sword.Transparency = 1
	end

	-- ท่าที่ 1: ยืนถือดาบปกติ
	if currentPose == 1 then
		mainWeld.C0 = CFrame.new(0, -1.5, 0) * CFrame.Angles(math.rad(90), 0, 0)

	-- ท่าที่ 2: หมุนดาบยักษ์อย่างรวดเร็ว
	elseif currentPose == 2 then
		local angle = 0
		spinConnection = runService.RenderStepped:Connect(function(deltaTime)
			angle = angle + math.rad(720 * deltaTime) -- ความเร็วในการหมุน
			mainWeld.C0 = CFrame.new(0, -1.5, 0) * CFrame.Angles(angle, math.rad(90), 0)
		end)

	-- ท่าที่ 3: ถือดาบ และมีดาบยักษ์อีก 3 เล่มลอยอยู่ด้านหลังเหมือนออร่า
	elseif currentPose == 3 then
		-- ถือดาบหลักท่าเตรียมพร้อม
		mainWeld.C0 = CFrame.new(0, -1.5, 0) * CFrame.Angles(math.rad(45), math.rad(45), 0)
		
		-- จัดเรียงดาบลอยด้านหลัง
		for i, fs in pairs(floatingSwords) do
			fs.sword.Transparency = 0.3 -- ให้โปร่งแสงนิดๆ เพื่อความเท่
			-- เรียงดาบให้กางออกเหมือนปีกนกด้านหลัง
			local spreadAngle = math.rad(-45 + ((i-1) * 45))
			fs.weld.C0 = CFrame.new(0, 2, 4) * CFrame.Angles(math.rad(-30), 0, spreadAngle)
		end
	end
end

-- ==========================================
-- 4. รับค่าการกดปุ่ม (1, 2, 3)
-- ==========================================
uis.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	
	if input.KeyCode == Enum.KeyCode.One then
		currentPose = 1
		updatePose()
	elseif input.KeyCode == Enum.KeyCode.Two then
		currentPose = 2
		updatePose()
	elseif input.KeyCode == Enum.KeyCode.Three then
		currentPose = 3
		updatePose()
	end
end)

-- โหลดท่าที่ 1 ทันทีเมื่อเริ่มเกม
updatePose()
